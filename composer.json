{
    "name": "featvalue/typo3",
    "description": "Embeds the FeatValue client portal in a TYPO3 website.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.featvalue.com/typo3",
    "keywords": ["typo3", "typo3-cms-extension", "client portal", "featvalue"],
    "authors": [
        {"name": "FeatValue", "email": "hello@featvalue.io", "homepage": "https://featvalue.io"}
    ],
    "support": {
        "docs": "https://www.featvalue.com/typo3",
        "email": "hello@featvalue.io",
        "source": "https://github.com/FeatValue/typo3",
        "issues": "https://github.com/FeatValue/typo3/issues"
    },
    "require": {
        "php": ">=8.2",
        "typo3/cms-core": "^13.4 || ^14.0",
        "typo3/cms-extbase": "^13.4 || ^14.0",
        "typo3/cms-backend": "^13.4 || ^14.0",
        "typo3/cms-frontend": "^13.4 || ^14.0",
        "typo3/cms-fluid-styled-content": "^13.4 || ^14.0",
        "typo3/cms-scheduler": "^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "Featvalue\\Typo3\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "featvalue"
        }
    }
}
