            <trans-unit id="settings.disconnect" resname="settings.disconnect" approved="yes"><source>Disconnect</source><target>डिस्कनेक्ट करें</target></trans-unit>
            <trans-unit id="settings.connected" resname="settings.connected" approved="yes"><source>This website is connected with FeatValue.</source><target>यह वेबसाइट FeatValue से जुड़ी है।</target></trans-unit>
            <trans-unit id="settings.notConnected" resname="settings.notConnected" approved="yes"><source>This website is not connected yet.</source><target>यह वेबसाइट अभी कनेक्ट नहीं है।</target></trans-unit>
            <trans-unit id="settings.siteType" resname="settings.siteType" approved="yes"><source>What kind of website is this?</source><target>यह किस तरह की वेबसाइट है?</target></trans-unit>
            <trans-unit id="settings.siteType.permanent" resname="settings.siteType.permanent" approved="yes"><source>This choice is permanent and cannot be changed later.</source><target>यह चयन स्थायी है और बाद में बदला नहीं जा सकता।</target></trans-unit>
            <trans-unit id="settings.siteType.client" resname="settings.siteType.client" approved="yes"><source>Client site (single client)</source><target>क्लाइंट साइट (एक क्लाइंट)</target></trans-unit>
            <trans-unit id="settings.siteType.clientHelp" resname="settings.siteType.clientHelp" approved="yes"><source>Tasks for this client can only be managed on this website.</source><target>इस क्लाइंट के कार्य केवल इस वेबसाइट पर प्रबंधित किए जा सकते हैं।</target></trans-unit>
            <trans-unit id="settings.siteType.agency" resname="settings.siteType.agency" approved="yes"><source>Agency site (multi-user setup)</source><target>एजेंसी साइट (बहु-उपयोगकर्ता)</target></trans-unit>
            <trans-unit id="settings.siteType.agencyHelp" resname="settings.siteType.agencyHelp" approved="yes"><source>This is the website of the service provider or agency with a multi-user setup.</source><target>यह सेवा प्रदाता या एजेंसी की वेबसाइट है, जिसमें कई उपयोगकर्ता हैं।</target></trans-unit>
            <trans-unit id="settings.save" resname="settings.save" approved="yes"><source>Save</source><target>सहेजें</target></trans-unit>
