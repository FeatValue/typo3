            <trans-unit id="content.finishSetup" resname="content.finishSetup" approved="yes"><source>Finish FeatValue setup before opening the dashboard.</source><target>डैशबोर्ड खोलने से पहले FeatValue सेटअप पूरा करें।</target></trans-unit>
            <trans-unit id="content.ssoLoginRequired" resname="content.ssoLoginRequired" approved="yes"><source>Please log in to view the dashboard.</source><target>डैशबोर्ड देखने के लिए साइन इन करें।</target></trans-unit>
            <trans-unit id="content.emailVerification" resname="content.emailVerification" approved="yes"><source>Please confirm your email address.</source><target>कृपया अपना ईमेल पता पुष्टि करें।</target></trans-unit>
            <trans-unit id="content.resend" resname="content.resend" approved="yes"><source>Send verification email again</source><target>सत्यापन ईमेल फिर भेजें</target></trans-unit>
            <trans-unit id="task.mailRelay.title" resname="task.mailRelay.title" approved="yes"><source>FeatValue mail relay</source><target>FeatValue मेल रिले</target></trans-unit>
            <trans-unit id="task.mailRelay.description" resname="task.mailRelay.description" approved="yes"><source>Pulls pending FeatValue emails and sends them through TYPO3 mail.</source><target>लंबित FeatValue ईमेल लाकर उन्हें TYPO3 के ज़रिए भेजता है।</target></trans-unit>
